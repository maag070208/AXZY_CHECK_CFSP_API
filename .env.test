# Base LOCAL de pruebas (Docker, checkapp_test). NUNCA apuntar a Railway aquí.
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/checkapp_test?connection_limit=10
PORT=4444
NODE_ENV=test

# ── Aislamiento de servicios externos ────────────────────────────────────────
# Las pruebas NUNCA deben tocar AWS/S3 de producción ni publicar en Ably real.
# Se definen aquí (y no se dejan vacías) para que `setup-env.ts` gane sobre `.env`:
# dotenv no sobrescribe variables ya definidas. El bucket es ficticio y las
# credenciales van vacías, así que cualquier llamada real a S3 falla sin efecto.
AWS_BUCKET_NAME=checkapp-test-bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
ABLY_API_KEY=
RESEND_API_KEY=
